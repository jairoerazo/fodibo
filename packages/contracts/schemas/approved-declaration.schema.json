{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fodibo.local/schemas/approved-declaration.schema.json",
  "title": "Declaración aprobada",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "case_id",
    "case_revision",
    "approved_at",
    "approver",
    "content_hash",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 0
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "$ref": "#/$defs/content"
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tax_year",
        "jurisdiction",
        "rules_version",
        "fields",
        "evidence",
        "documents"
      ],
      "properties": {
        "tax_year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "jurisdiction": {
          "enum": [
            "AG",
            "AI",
            "AR",
            "BE",
            "BL",
            "BS",
            "FR",
            "GE",
            "GL",
            "GR",
            "JU",
            "LU",
            "NE",
            "NW",
            "OW",
            "SG",
            "SH",
            "SO",
            "SZ",
            "TG",
            "TI",
            "UR",
            "VD",
            "VS",
            "ZG",
            "ZH"
          ]
        },
        "rules_version": {
          "type": "null"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        }
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "valor",
            "moneda"
          ],
          "properties": {
            "tipo": {
              "const": "amount"
            },
            "valor": {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$"
            },
            "moneda": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "valor"
          ],
          "properties": {
            "tipo": {
              "const": "boolean"
            },
            "valor": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "valor"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "text",
                "date",
                "iban",
                "enum"
              ]
            },
            "valor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "sha256",
        "page"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "sha256",
        "mime",
        "doc_type"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic",
            "application/pdf",
            "application/json"
          ]
        },
        "doc_type": {
          "enum": [
            "lohnausweis",
            "bankbeleg",
            "krankenkasse",
            "saeule_3a",
            "quittung",
            "sonstiges"
          ]
        }
      }
    }
  }
}
