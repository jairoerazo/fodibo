{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fodibo.local/schemas/qr.schema.json",
  "title": "QR de emparejamiento",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "hosts", "port", "fp", "secret", "exp"],
  "properties": {
    "v": { "const": 1 },
    "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "ipv4" } },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "fp": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "secret": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
    "exp": { "type": "string", "format": "date-time" }
  }
}
