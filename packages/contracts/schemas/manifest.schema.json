{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fodibo.local/schemas/manifest.schema.json",
  "title": "Manifiesto de paquete",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "created_at", "device_name", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "package_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "device_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "files": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "name", "mime", "size", "sha256"],
      "properties": {
        "file_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mime": { "enum": ["image/jpeg", "image/png", "image/heic", "application/pdf", "application/json"] },
        "size": { "type": "integer", "minimum": 0, "maximum": 52428800 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
